# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for Telegram webhooks)
APP_URL="MY_APP_URL"

# TELEGRAM BOT INTEGRATION: Configured on server-side only
# Never exposed in frontend client code or public responses
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# ADMIN AUTHENTICATION
ADMIN_EMAIL="admin@sonofgrace.com"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"
ADMIN_SECURITY_PIN="YOUR_4_DIGIT_PIN"
